{
  "name": "digitutor",
  "version": "0.2.3",
  "description": "A study tutor that lives in your system tray: hit a hotkey, it screenshots your screen, listens to your question, and answers with AI.",
  "main": "out/main/index.js",
  "author": "DigiTutor",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "check:sdk-pin": "node scripts/check-sdk-pin.mjs",
    "check:key-storage": "node scripts/check-key-storage.mjs",
    "validate": "npm run typecheck && npm run check:sdk-pin && npm run check:key-storage",
    "geticon": "node scripts/gen-icon.mjs",
    "dist": "npm run build && npm run geticon && electron-builder",
    "release:web": "node scripts/release-web.mjs",
    "deploy:web": "netlify deploy --prod --dir=website",
    "ship": "npm run dist && npm run release:web && npm run deploy:web"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.52.0"
  },
  "overrides": {
    "kokoro-js": {
      "@huggingface/transformers": "$@huggingface/transformers"
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "kokoro-js": "^1.2.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.0",
    "dompurify": "^3.2.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "katex": "^0.16.11",
    "marked": "^15.0.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
